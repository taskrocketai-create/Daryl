# Copy this file to .env and fill in real values. Never commit .env.

OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Requires Wyze RTSP Firmware enabled on the camera
WYZE_RTSP_URL=rtsp://user:pass@192.168.8.100/live

# Find with: Windows Device Manager (COMx) / macOS+Linux: ls /dev/tty.* or /dev/ttyUSB*
ARDUINO_SERIAL_PORT=/dev/ttyUSB0
ARDUINO_BAUD_RATE=9600

TRIGGER_DISTANCE_CM=150
DWELL_SECONDS=1.5
COOLDOWN_SECONDS=75
WALKAWAY_DELTA_CM=60

# Blue Charm BC011 (or similar) iBeacon UUID, from its configuration app
BOSSMAN_BEACON_UUID=
BLE_RSSI_THRESHOLD=-70
BLE_LOST_GRACE_SECONDS=5
BOSSMAN_LINE_MIN_INTERVAL_SECONDS=240

WEBHOOK_PORT=5005
AUDIO_TEMP_DIR=/tmp/daryl_audio

# Same-day visitor memory — see README for the legal check done for
# NC/SC/GA/FL/VA/MS/UT specifically before enabling this
ENABLE_VISITOR_MEMORY=true
FACE_MATCH_CONFIDENT_THRESHOLD=55
FACE_MATCH_UNCERTAIN_THRESHOLD=85
